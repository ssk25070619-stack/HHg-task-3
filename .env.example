# 1. Vision & Reverse Image Search APIs (Choose any or all)
# Google Gemini Multimodal Vision AI Key (Recommended - direct Instagram matching)
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI Google Lens Key (Optional)
SERPAPI_KEY=your_serpapi_api_key_here

# Google Cloud Vision API Key (Optional)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_key_here

# ImgBB API Key for public image hosting bridge (Optional)
IMGBB_API_KEY=your_imgbb_api_key_here

# 2. Blockchain Configuration (Ethereum Sepolia / Polygon Amoy)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=your_testnet_private_key_here
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 3. Server Configuration
PORT=5000
